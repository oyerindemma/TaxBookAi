model ClientBusiness {
  id                      Int                  @id @default(autoincrement())
  workspaceId             Int
  name                    String
  legalName               String?
  industry                String?
  country                 String               @default("Nigeria")
  state                   String?
  taxIdentificationNumber String?
  vatRegistrationNumber   String?
  defaultCurrency         String               @default("NGN")
  fiscalYearStartMonth    Int                  @default(1)
  status                  ClientBusinessStatus @default(ACTIVE)
  archivedAt              DateTime?
  notes                   String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  workspace                 Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vendors                   Vendor[]
  categories                TransactionCategory[]
  transactions              LedgerTransaction[]
  bookkeepingUploads        BookkeepingUpload[]
  bankAccounts              BankAccount[]
  bankStatementImports      BankStatementImport[]
  bankTransactions          BankTransaction[]
  bankTransactionSplitLines BankTransactionSplitLine[]
  invoices                  Invoice[]
  taxRecords                TaxRecord[]
  taxPeriods                TaxPeriod[]
  citPeriods                CITPeriod[]
  citBlockers               CITBlocker[]
  taxComputations           TaxComputation[]
  vatRecords                VATRecord[]
  whtRecords                WHTRecord[]
  taxAdjustments            TaxAdjustment[]
  filingDrafts              FilingDraft[]
  filingEvidence            FilingEvidence[]
  workspaceAlerts           WorkspaceAlert[]
  expenseLeakFindings       ExpenseLeakFinding[]
  defaultWhatsAppReceiptConnections WhatsAppReceiptConnection[] @relation("WhatsAppReceiptConnectionDefaultBusiness")
  whatsAppReceiptSenderMappings WhatsAppReceiptSenderMapping[]
  whatsAppReceiptMessages       WhatsAppReceiptMessage[]
  defaultPaymentProviderConnections PaymentProviderConnection[] @relation("PaymentProviderConnectionDefaultBusiness")
  paymentTransactionCandidates      PaymentTransactionCandidate[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@index([workspaceId, archivedAt])
}

model WorkspaceAlert {
  id                    Int                    @id @default(autoincrement())
  workspaceId           Int
  clientBusinessId      Int?
  statusChangedByUserId Int?
  type                  WorkspaceAlertType
  severity              WorkspaceAlertSeverity @default(INFO)
  status                WorkspaceAlertStatus   @default(OPEN)
  dedupeKey             String
  title                 String
  message               String
  explanation           String?
  recommendedActionLabel String?
  recommendedActionHref String?
  primaryRecordType     String?
  primaryRecordId       Int?
  primaryRecordHref     String?
  recordCount           Int                    @default(0)
  sourceRecordsPayload  String?
  metadataPayload       String?
  firstDetectedAt       DateTime               @default(now())
  lastDetectedAt        DateTime               @default(now())
  snoozedUntil          DateTime?
  resolvedAt            DateTime?
  lastStatusChangedAt   DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientBusiness  ClientBusiness? @relation(fields: [clientBusinessId], references: [id], onDelete: SetNull)
  statusChangedBy User?          @relation("WorkspaceAlertStatusActor", fields: [statusChangedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, status, severity, lastDetectedAt])
  @@index([workspaceId, type, status])
  @@index([clientBusinessId, status, severity])
  @@index([statusChangedByUserId])
}

model ExpenseLeakFinding {
  id                    Int                        @id @default(autoincrement())
  workspaceId           Int
  clientBusinessId      Int?
  statusChangedByUserId Int?
  type                  ExpenseLeakFindingType
  severity              ExpenseLeakFindingSeverity @default(INFO)
  status                ExpenseLeakFindingStatus   @default(OPEN)
  dedupeKey             String
  title                 String
  summary               String
  explanation           String?
  estimatedSavingsMinor Int                        @default(0)
  currency              String                     @default("NGN")
  recommendedActionLabel String?
  recommendedActionHref String?
  primaryRecordType     String?
  primaryRecordId       Int?
  primaryRecordHref     String?
  recordCount           Int                        @default(0)
  evidencePayload       String?
  metadataPayload       String?
  firstDetectedAt       DateTime                   @default(now())
  lastDetectedAt        DateTime                   @default(now())
  dismissedAt           DateTime?
  resolvedAt            DateTime?
  lastStatusChangedAt   DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientBusiness  ClientBusiness? @relation(fields: [clientBusinessId], references: [id], onDelete: SetNull)
  statusChangedBy User?           @relation("ExpenseLeakFindingStatusActor", fields: [statusChangedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, status, severity, lastDetectedAt])
  @@index([workspaceId, type, status])
  @@index([workspaceId, status, estimatedSavingsMinor])
  @@index([clientBusinessId, status, severity])
  @@index([statusChangedByUserId])
}

model Vendor {
  id                      Int      @id @default(autoincrement())
  clientBusinessId        Int
  name                    String
  email                   String?
  phone                   String?
  taxIdentificationNumber String?
  vatRegistrationNumber   String?
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  clientBusiness            ClientBusiness             @relation(fields: [clientBusinessId], references: [id], onDelete: Cascade)
  transactions              LedgerTransaction[]
  drafts                    BookkeepingDraft[]
  bankTransactionSplitLines BankTransactionSplitLine[]

  @@unique([clientBusinessId, name])
  @@index([clientBusinessId, name])
}

model TransactionCategory {
  id               Int                @id @default(autoincrement())
  clientBusinessId Int
  name             String
  code             String?
  type             LedgerCategoryType @default(EXPENSE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  clientBusiness            ClientBusiness             @relation(fields: [clientBusinessId], references: [id], onDelete: Cascade)
  transactions              LedgerTransaction[]
  drafts                    BookkeepingDraft[]
  bankTransactions          BankTransaction[]
  suggestedBankTransactions BankTransaction[] @relation("SuggestedBankTransactionCategory")
  bankTransactionSplitLines BankTransactionSplitLine[]
  suggestedCategorizationFeedback BankTransactionCategorizationFeedback[] @relation("BankTransactionCategorizationSuggestedCategory")
  selectedCategorizationFeedback BankTransactionCategorizationFeedback[] @relation("BankTransactionCategorizationSelectedCategory")
  suggestedBookkeepingFeedback BankTransactionBookkeepingFeedback[] @relation("BankTransactionBookkeepingSuggestedCategory")
  selectedBookkeepingFeedback BankTransactionBookkeepingFeedback[] @relation("BankTransactionBookkeepingSelectedCategory")

  @@unique([clientBusinessId, name])
  @@index([clientBusinessId, type, name])
}

model LedgerTransaction {
  id                   Int                     @id @default(autoincrement())
  clientBusinessId     Int
  vendorId             Int?
  categoryId           Int?
  bankTransactionId    Int?
  sourceDraftId        Int?                    @unique
  createdByUserId      Int?
  transactionDate      DateTime
  description          String
  reference            String?
  direction            LedgerDirection
  amountMinor          Int
  currency             String                  @default("NGN")
  vatAmountMinor       Int                     @default(0)
  whtAmountMinor       Int                     @default(0)
  vatTreatment         VatTreatment            @default(NONE)
  whtTreatment         WhtTreatment            @default(NONE)
  taxCategory          TaxCategory?
  taxEvidenceStatus    TaxEvidenceStatus       @default(UNKNOWN)
  filingPeriodKey      String?
  sourceDocumentNumber String?
  origin               TransactionOrigin       @default(MANUAL)
  reviewStatus         TransactionReviewStatus @default(DRAFT)
  notes                String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  clientBusiness           ClientBusiness             @relation(fields: [clientBusinessId], references: [id], onDelete: Cascade)
  vendor                   Vendor?                    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  category                 TransactionCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  bankTransaction          BankTransaction?           @relation("BankTransactionLedgerEntries", fields: [bankTransactionId], references: [id], onDelete: SetNull)
  sourceDraft              BookkeepingDraft?          @relation("DraftToTransaction", fields: [sourceDraftId], references: [id], onDelete: SetNull)
  createdBy                User?                      @relation("LedgerTransactionActor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedBankTransactions BankTransaction[]          @relation("ApprovedBankTransactionLedger")
  splitLines               BankTransactionSplitLine[]
  reconciliationMatches    ReconciliationMatch[]
  vatRecords               VATRecord[]
  whtRecords               WHTRecord[]

  @@index([clientBusinessId, transactionDate])
  @@index([clientBusinessId, reviewStatus])
  @@index([vendorId, transactionDate])
  @@index([categoryId, transactionDate])
  @@index([bankTransactionId])
}

model BookkeepingUpload {
  id                  Int                     @id @default(autoincrement())
  workspaceId         Int
  clientBusinessId    Int
  uploadedByUserId    Int?
  fileName            String
  fileType            String?
  sourceType          BookkeepingUploadSource @default(OTHER)
  documentType        BookkeepingDocumentType @default(UNKNOWN)
  status              BookkeepingUploadStatus @default(UPLOADED)
  ingestionChannel    BookkeepingIngestionChannel @default(DIRECT_UPLOAD)
  uploadSizeBytes     Int?
  fileHash            String?
  fileData            Bytes?
  reviewNotes         String?
  rawText             String?
  aiPayload           String?
  failureReason       String?
  duplicateOfUploadId Int?
  duplicateConfidence Float?
  duplicateReason     String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  extractedAt         DateTime?
  reviewedAt          DateTime?

  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientBusiness    ClientBusiness      @relation(fields: [clientBusinessId], references: [id], onDelete: Cascade)
  uploadedBy        User?               @relation("BookkeepingUploadActor", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  duplicateOfUpload BookkeepingUpload?  @relation("BookkeepingUploadDuplicates", fields: [duplicateOfUploadId], references: [id], onDelete: SetNull)
  duplicateUploads  BookkeepingUpload[] @relation("BookkeepingUploadDuplicates")
  drafts            BookkeepingDraft[]
  filingEvidences   FilingEvidence[]
  whatsAppReceiptMessage WhatsAppReceiptMessage?

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, ingestionChannel, createdAt])
  @@index([workspaceId, documentType, createdAt])
  @@index([clientBusinessId, status, createdAt])
  @@index([uploadedByUserId])
  @@index([fileHash])
  @@index([duplicateOfUploadId])
}

model BookkeepingDraft {
  id                     Int               @id @default(autoincrement())
  uploadId               Int
  vendorId               Int?
  categoryId             Int?
  reviewedByUserId       Int?
  proposedDate           DateTime?
  description            String?
  reference              String?
  documentNumber         String?
  vendorName             String?
  suggestedCategoryName  String?
  paymentMethod          String?
  direction              LedgerDirection
  subtotalMinor          Int?
  amountMinor            Int?
  totalAmountMinor       Int?
  taxAmountMinor         Int?
  taxRate                Float             @default(0)
  currency               String            @default("NGN")
  vatAmountMinor         Int               @default(0)
  whtAmountMinor         Int               @default(0)
  vatTreatment           VatTreatment      @default(NONE)
  whtTreatment           WhtTreatment      @default(NONE)
  taxCategory            TaxCategory?
  taxEvidenceStatus      TaxEvidenceStatus @default(UNKNOWN)
  filingPeriodKey        String?
  confidence             Float?
  deductibilityHint      String?
  fieldConfidencePayload String?
  lineItemsPayload       String?
  reviewStatus           DraftReviewStatus @default(PENDING)
  reviewerNote           String?
  aiPayload              String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  reviewedAt             DateTime?
