datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                               Int                        @id @default(autoincrement())
  email                            String                     @unique
  password                         String
  fullName                         String
  role                             Role                       @default(USER)
  createdAt                        DateTime                   @default(now())
  sessions                         Session[]
  passwordResetTokens              PasswordResetToken[]
  workspaces                       WorkspaceMember[]
  taxRecords                       TaxRecord[]
  auditLogs                        AuditLog[]                 @relation("AuditActor")
  auditTargets                     AuditLog[]                 @relation("AuditTarget")
  bookkeepingUploads               BookkeepingUpload[]        @relation("BookkeepingUploadActor")
  bankStatementImports             BankStatementImport[]      @relation("BankStatementImportActor")
  importedBankTransactions         BankTransaction[]          @relation("BankTransactionActor")
  reviewedBankTransactions         BankTransaction[]          @relation("BankTransactionReviewer")
  bankTransactionCategorizationFeedback BankTransactionCategorizationFeedback[] @relation("BankTransactionCategorizationFeedbackActor")
  bankTransactionBookkeepingFeedback BankTransactionBookkeepingFeedback[] @relation("BankTransactionBookkeepingFeedbackActor")
  ledgerTransactions               LedgerTransaction[]        @relation("LedgerTransactionActor")
  approvedReconciliationMatches    ReconciliationMatch[]      @relation("ReconciliationMatchApprover")
  createdBankTransactionSplitLines BankTransactionSplitLine[] @relation("BankTransactionSplitActor")
  reviewedBookkeepingDrafts        BookkeepingDraft[]         @relation("BookkeepingDraftReviewer")
  reviewedTaxRecords               TaxRecord[]                @relation("TaxRecordReviewer")
  reviewedTaxPeriods               TaxPeriod[]                @relation("TaxPeriodReviewer")
  reviewedCitPeriods               CITPeriod[]                @relation("CITPeriodReviewer")
  reviewedVatRecords               VATRecord[]                @relation("VatRecordReviewer")
  reviewedWhtRecords               WHTRecord[]                @relation("WhtRecordReviewer")
  createdTaxAdjustments            TaxAdjustment[]            @relation("TaxAdjustmentCreator")
  reviewedFilingDrafts             FilingDraft[]              @relation("FilingDraftReviewer")
  filingEvidenceUploads            FilingEvidence[]           @relation("FilingEvidenceUploader")
  submissionLogs                   SubmissionLog[]            @relation("SubmissionLogActor")
  workspaceAlertStatusChanges      WorkspaceAlert[]           @relation("WorkspaceAlertStatusActor")
  expenseLeakFindingStatusChanges  ExpenseLeakFinding[]       @relation("ExpenseLeakFindingStatusActor")
  createdWhatsAppReceiptConnections WhatsAppReceiptConnection[] @relation("WhatsAppReceiptConnectionCreator")
  updatedWhatsAppReceiptConnections WhatsAppReceiptConnection[] @relation("WhatsAppReceiptConnectionUpdater")
  createdWhatsAppReceiptSenderMappings WhatsAppReceiptSenderMapping[] @relation("WhatsAppReceiptSenderMappingCreator")
  updatedWhatsAppReceiptSenderMappings WhatsAppReceiptSenderMapping[] @relation("WhatsAppReceiptSenderMappingUpdater")
}

enum Role {
  USER
  ADMIN
  TEST
}

model Workspace {
  id                    Int                    @id @default(autoincrement())
  name                  String
  createdAt             DateTime               @default(now())
  archivedAt            DateTime?
  businessProfile       BusinessProfile?
  onboardingProfile     WorkspaceOnboarding?
  members               WorkspaceMember[]
  taxRecords            TaxRecord[]
  invites               Invite[]
  auditLogs             AuditLog[]
  subscription          WorkspaceSubscription?
  clients               Client[]
  invoices              Invoice[]
  payments              Payment[]
  paymentProviderConnections PaymentProviderConnection[]
  paymentProviderEvents      PaymentProviderEvent[]
  paymentSettlements         PaymentSettlement[]
  paymentTransactionCandidates PaymentTransactionCandidate[]
  recurringInvoices     RecurringInvoice[]
  bankAccounts          BankAccount[]
  bankStatementImports  BankStatementImport[]
  bankTransactions      BankTransaction[]
  bankTransactionCategorizationFeedback BankTransactionCategorizationFeedback[]
  bankTransactionBookkeepingFeedback BankTransactionBookkeepingFeedback[]
  reconciliationMatches ReconciliationMatch[]
  expenseCategories     ExpenseCategory[]
  clientBusinesses      ClientBusiness[]
  bookkeepingUploads    BookkeepingUpload[]
  taxPeriods            TaxPeriod[]
  citPeriods            CITPeriod[]
  citBlockers           CITBlocker[]
  taxComputations       TaxComputation[]
  vatRecords            VATRecord[]
  whtRecords            WHTRecord[]
  taxAdjustments        TaxAdjustment[]
  filingDrafts          FilingDraft[]
  filingEvidence        FilingEvidence[]
  submissionLogs        SubmissionLog[]
  billingWebhookEvents  BillingWebhookEvent[]
  integrityIssues       IntegrityIssue[]
  alerts                WorkspaceAlert[]
  expenseLeakFindings   ExpenseLeakFinding[]
  whatsAppReceiptConnections    WhatsAppReceiptConnection[]
  whatsAppReceiptSenderMappings WhatsAppReceiptSenderMapping[]
  whatsAppReceiptMessages       WhatsAppReceiptMessage[]

  @@index([archivedAt])
}

model BusinessProfile {
  id                      Int       @id @default(autoincrement())
  workspaceId             Int       @unique
  businessName            String
  businessType            String
  industry                String
  country                 String
  state                   String
  taxIdentificationNumber String?
  defaultCurrency         String    @default("NGN")
  fiscalYearStartMonth    Int       @default(1)
  onboardingCompletedAt   DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([onboardingCompletedAt])
}

model WorkspaceOnboarding {
  id                      Int                      @id @default(autoincrement())
  workspaceId             Int                      @unique
  status                  WorkspaceOnboardingStatus @default(IN_PROGRESS)
  userType                OnboardingUserType?
  businessName            String?
  businessType            String?
  industry                String?
  country                 String                   @default("Nigeria")
  state                   String?
  taxIdentificationNumber String?
  defaultCurrency         String                   @default("NGN")
  fiscalYearStartMonth    Int                      @default(1)
  vatApplicability        TaxApplicability?
  whtApplicability        TaxApplicability?
  multiBusinessNeed       MultiBusinessNeed?
  currentStep             String?
  draftSavedAt            DateTime?
  completedAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([completedAt])
}

model WorkspaceMember {
  id          Int           @id @default(autoincrement())
  workspaceId Int
  userId      Int
  role        WorkspaceRole @default(VIEWER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

