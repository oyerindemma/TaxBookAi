model BankTransaction {
  id                             Int                              @id @default(autoincrement())
  workspaceId                    Int
  clientBusinessId               Int?
  bankAccountId                  Int
  statementImportId              Int?
  uploadedByUserId               Int?
  categoryId                     Int?
  suggestedCategoryId            Int?
  matchedLedgerTransactionId     Int?
  matchedInvoiceId               Int?
  possibleDuplicateOfTransactionId Int?
  transactionDate                DateTime
  description                    String
  reference                      String?
  amount                         Int
  debitAmountMinor               Int?
  creditAmountMinor              Int?
  balanceAmountMinor             Int?
  type                           BankTransactionType
  source                         BankTransactionSource           @default(CSV_IMPORT)
  status                         BankTransactionStatus           @default(UNMATCHED)
  reviewStatus                   BankTransactionReviewStatus     @default(IMPORTED)
  fingerprintHash                String?
  sourceRowNumber                Int?
  rawRowPayload                  String?
  currency                       String                           @default("NGN")
  suggestedType                  BankTransactionBusinessType      @default(UNKNOWN)
  suggestedCounterparty          String?
  suggestedCategoryName          String?
  vatTreatment                   VatTreatment                     @default(NONE)
  whtTreatment                   WhtTreatment                     @default(NONE)
  vatRate                        Float                            @default(0)
  whtRate                        Float                            @default(0)
  vatAmountMinor                 Int                              @default(0)
  whtAmountMinor                 Int                              @default(0)
  taxTreatmentSource             BankTransactionTaxTreatmentSource @default(UNSET)
  suggestedVatTreatment          VatTreatment                     @default(NONE)
  suggestedWhtTreatment          WhtTreatment                     @default(NONE)
  suggestedNarrationMeaning      String?
  confidenceScore                Float?
  categorizationProvider         String?
  suggestionConfidence           Float?
  suggestionReason               String?
  normalizedDescription          String?
  normalizedMerchantName         String?
  autoBookkeepingConfidence      Float?
  autoBookkeepingReason          String?
  autoBookkeepingProvider        String?
  autoBookkeepingProcessedAt     DateTime?
  postingReadiness               BankTransactionPostingReadiness  @default(NOT_READY)
  duplicateConfidence            Float?
  duplicateReason                String?
  suspiciousPatternScore         Float?
  suspiciousPatternReason        String?
  reviewNotes                    String?
  reviewedAt                     DateTime?
  reviewedByUserId               Int?
  matchedAt                      DateTime?
  ignoredAt                      DateTime?
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime                         @updatedAt

  workspace                    Workspace                           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientBusiness               ClientBusiness?                     @relation(fields: [clientBusinessId], references: [id], onDelete: SetNull)
  bankAccount                  BankAccount                         @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  statementImport              BankStatementImport?                @relation(fields: [statementImportId], references: [id], onDelete: SetNull)
  uploadedBy                   User?                               @relation("BankTransactionActor", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  reviewedBy                   User?                               @relation("BankTransactionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  category                     TransactionCategory?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  suggestedCategory            TransactionCategory?                @relation("SuggestedBankTransactionCategory", fields: [suggestedCategoryId], references: [id], onDelete: SetNull)
  matchedLedgerTransaction     LedgerTransaction?                  @relation("ApprovedBankTransactionLedger", fields: [matchedLedgerTransactionId], references: [id], onDelete: SetNull)
  matchedInvoice               Invoice?                            @relation("ApprovedBankTransactionInvoice", fields: [matchedInvoiceId], references: [id], onDelete: SetNull)
  possibleDuplicateOf          BankTransaction?                    @relation("BankTransactionPossibleDuplicate", fields: [possibleDuplicateOfTransactionId], references: [id], onDelete: SetNull)
  possibleDuplicates           BankTransaction[]                   @relation("BankTransactionPossibleDuplicate")
  matches                      ReconciliationMatch[]
  categorizationFeedback       BankTransactionCategorizationFeedback[]
  bookkeepingFeedback          BankTransactionBookkeepingFeedback[]
  ledgerTransactions           LedgerTransaction[]                 @relation("BankTransactionLedgerEntries")
  taxRecords                   TaxRecord[]                         @relation("BankTransactionTaxRecords")
  splitLines                   BankTransactionSplitLine[]
  vatrecords                   VATRecord[]
  whtrecords                   WHTRecord[]
  paymentTransactionCandidates PaymentTransactionCandidate[]       @relation("PaymentCandidateBankTransaction")
  suggestedPaymentTransactionCandidates PaymentTransactionCandidate[] @relation("PaymentCandidateSuggestedBankTransaction")

  @@index([workspaceId, transactionDate])
  @@index([workspaceId, status, transactionDate])
  @@index([workspaceId, reviewStatus, transactionDate])
  @@index([workspaceId, postingReadiness, transactionDate])
  @@index([workspaceId, source, transactionDate])
  @@index([workspaceId, categoryId, transactionDate])
  @@index([workspaceId, suggestedCategoryId, transactionDate])
  @@index([workspaceId, autoBookkeepingConfidence, transactionDate])
  @@index([workspaceId, normalizedMerchantName, transactionDate])
  @@index([workspaceId, vatTreatment, transactionDate])
  @@index([workspaceId, whtTreatment, transactionDate])
  @@index([workspaceId, taxTreatmentSource, transactionDate])
  @@index([bankAccountId, transactionDate])
  @@index([clientBusinessId, transactionDate])
  @@index([categoryId])
  @@index([suggestedCategoryId])
  @@index([reviewedByUserId, transactionDate])
  @@index([statementImportId, sourceRowNumber])
  @@index([matchedLedgerTransactionId])
  @@index([matchedInvoiceId])
  @@index([possibleDuplicateOfTransactionId])
  @@unique([workspaceId, bankAccountId, fingerprintHash])
}

model BankTransactionCategorizationFeedback {
  id                   Int                                           @id @default(autoincrement())
  workspaceId          Int
  transactionId        Int
  actorUserId          Int?
  suggestedCategoryId  Int?
  selectedCategoryId   Int?
  decision             BankTransactionCategorizationFeedbackDecision
  suggestionConfidence Float?
  suggestionReason     String?
  provider             String?
  note                 String?
  createdAt            DateTime                                      @default(now())

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transaction        BankTransaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  actor              User?               @relation("BankTransactionCategorizationFeedbackActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  suggestedCategory  TransactionCategory? @relation("BankTransactionCategorizationSuggestedCategory", fields: [suggestedCategoryId], references: [id], onDelete: SetNull)
  selectedCategory   TransactionCategory? @relation("BankTransactionCategorizationSelectedCategory", fields: [selectedCategoryId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([transactionId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([suggestedCategoryId])
  @@index([selectedCategoryId])
}

model BankTransactionBookkeepingFeedback {
  id                     Int                                      @id @default(autoincrement())
  workspaceId            Int
  transactionId          Int
  actorUserId            Int?
  suggestedCategoryId    Int?
  selectedCategoryId     Int?
  suggestedVatTreatment  VatTreatment                             @default(NONE)
  selectedVatTreatment   VatTreatment                             @default(NONE)
  suggestedWhtTreatment  WhtTreatment                             @default(NONE)
  selectedWhtTreatment   WhtTreatment                             @default(NONE)
  suggestedConfidence    Float?
  duplicateConfidence    Float?
  suspiciousPatternScore Float?
  postingReadiness       BankTransactionPostingReadiness          @default(NOT_READY)
  decision               BankTransactionBookkeepingFeedbackDecision
  provider               String?
  reason                 String?
  note                   String?
  createdAt              DateTime                                 @default(now())

  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transaction        BankTransaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  actor              User?                @relation("BankTransactionBookkeepingFeedbackActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  suggestedCategory  TransactionCategory? @relation("BankTransactionBookkeepingSuggestedCategory", fields: [suggestedCategoryId], references: [id], onDelete: SetNull)
  selectedCategory   TransactionCategory? @relation("BankTransactionBookkeepingSelectedCategory", fields: [selectedCategoryId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([transactionId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([suggestedCategoryId])
  @@index([selectedCategoryId])
}

model ReconciliationMatch {
  id                  Int                       @id @default(autoincrement())
  workspaceId         Int
  bankTransactionId   Int
  ledgerTransactionId Int?
  bookkeepingDraftId  Int?
  invoiceId           Int?
  taxRecordId         Int?
  matchType           ReconciliationMatchType
  status              ReconciliationMatchStatus @default(SUGGESTED)
  score               Float                     @default(0)
  matchedAmountMinor  Int?
  rationale           String?
  approvedByUserId    Int?
  approvedAt          DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bankTransaction   BankTransaction    @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id], onDelete: SetNull)
  bookkeepingDraft  BookkeepingDraft?  @relation(fields: [bookkeepingDraftId], references: [id], onDelete: SetNull)
  invoice           Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  taxRecord         TaxRecord?         @relation(fields: [taxRecordId], references: [id], onDelete: SetNull)
  approvedBy        User?              @relation("ReconciliationMatchApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([bankTransactionId, status])
  @@index([workspaceId, createdAt])
  @@index([ledgerTransactionId])
  @@index([bookkeepingDraftId])
  @@index([invoiceId])
  @@index([taxRecordId])
}

model BankTransactionSplitLine {
